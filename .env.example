# Required: get a free key at https://console.groq.com (no credit card)
GROQ_API_KEY=gsk_your_key_here

# Optional fallback provider; free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# LLM provider: groq | gemini
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Local models (downloaded automatically on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# Retrieval knobs
TOP_K_BM25=15
TOP_K_VECTOR=15
TOP_K_FINAL=5

# Ingestion limits (tuned for HF Spaces free tier)
MAX_FILES=500
MAX_FILE_SIZE_KB=300

# Cache root. Auto-overridden to /data/ when running on HF Spaces.
CACHE_DIR=./.repochat_cache
MAX_CACHE_GB=5

# Logging
LOG_LEVEL=INFO

# Optional: raises GitHub anonymous clone rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=
